# Local development only. Copy to .env and replace secrets before deploying.
POSTGRES_DB=alsaqr_saas
POSTGRES_USER=alsaqr_app
POSTGRES_PASSWORD=local_dev_change_this_password
DATABASE_URL=postgresql+asyncpg://alsaqr_app:local_dev_change_this_password@db:5432/alsaqr_saas
JWT_SECRET_KEY=local-only-secret-key-change-this-to-a-random-value-at-least-32-chars
JWT_ACCESS_TOKEN_MINUTES=20
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000/api/v1
