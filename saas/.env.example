# Local development only. Replace all passwords and JWT secret before deploying.
POSTGRES_DB=alsaqr_saas
POSTGRES_ADMIN_PASSWORD=local_admin_change_this_password
POSTGRES_APP_PASSWORD=local_app_change_this_password
POSTGRES_MIGRATION_PASSWORD=local_migrator_change_this_password
DATABASE_URL=postgresql+asyncpg://alsaqr_app:local_app_change_this_password@db:5432/alsaqr_saas
MIGRATION_DATABASE_URL=postgresql+asyncpg://alsaqr_migrator:local_migrator_change_this_password@db:5432/alsaqr_saas
JWT_SECRET_KEY=local-only-secret-key-change-this-to-a-random-value-at-least-32-chars
JWT_ACCESS_TOKEN_MINUTES=20
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000/api/v1
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
